install.packages(c("tidyverse","sf","rnaturalearth","rnaturalearthdata"))
library(readr)
ibs_dummy_2018_2022 <- read_csv("ibs_dummy_2018_2022.csv")
View(ibs_dummy_2018_2022)
library(readr)
imk1_dummy_2018_2022 <- read_csv("imk1_dummy_2018_2022.csv")
View(imk1_dummy_2018_2022)
library(readr)
imk2_dummy_2018_2022 <- read_csv("imk2_dummy_2018_2022.csv")
View(imk2_dummy_2018_2022)
names(ibs_dummy_2018_2022)
names(imk1_dummy_2018_2022)
names(imk2_dummy_2018_2022)
ibs_prov <- ibs_dummy_2018_2022 %>%
group_by(PROV) %>%
summarise(
IBS = n()
)
library(tidyverse)
ibs_prov <- ibs_dummy_2018_2022 %>%
group_by(PROV) %>%
summarise(
IBS = n()
)
ibs_prov
print(ibs_prov, n = Inf)
dim(imk1_dummy_2018_2022)
dim(imk2_dummy_2018_2022)
names(imk2_dummy_2018_2022)
imk <- imk1_dummy_2018_2022 %>%
left_join(
imk2_dummy_2018_2022 %>%
select(-PROV, -TAHUN, -KBLI, -KLAS, -WEIGHT),
by = "RENUM"
)
imk_prov <- imk1_dummy_2018_2022 %>%
group_by(PROV) %>%
summarise(
IMK = sum(WEIGHT, na.rm = TRUE)
)
View(imk_prov)
comparison <- full_join(
ibs_prov,
imk_prov,
by = "PROV"
)
comparison
imk_prov <- imk1_dummy_2018_2022 %>%
group_by(PROV) %>%
summarise(
IMK = n()
)
View(imk_prov)
comparison <- full_join(
ibs_prov,
imk_prov,
by = "PROV"
)
comparison
comparison <- comparison %>%
mutate(
Total = IBS + IMK,
Percent_IBS = IBS / Total * 100,
Percent_IMK = IMK / Total * 100
)
print(comparison, n = Inf)
imk_kbli <- imk1_dummy_2018_2022 %>%
group_by(PROV, KBLI) %>%
summarise(
IMK = n(),
.groups = "drop"
)
print(imk_kbli, n = Inf)
imk_kbli <- imk_kbli %>%
group_by(PROV) %>%
mutate(
Total_IMK = sum(IMK),
Percent = IMK / Total_IMK * 100
)
View(imk_kbli)
